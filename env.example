# Variable NAMES with safe placeholder values only. Never commit real values.
# Kiosk: copy to /etc/heritage-kiosk/device.env (mode 0600). API/worker: inject from the secret store.

# ── Kiosk agent (Pi) ── README §46.1
KIOSK_EVENT_URL=http://127.0.0.1:8765/device/event
KIOSK_EVENT_PORT=8765
KIOSK_UI_DIR=/home/pi/archive/ui
KIOSK_PIR_PIN=17
KIOSK_HOME_PIN=27
KIOSK_LED_PIN=22
KIOSK_PIR_COOLDOWN_S=10
KIOSK_PIR_WARMUP_S=30
KIOSK_IDLE_S=120
KIOSK_COUNTDOWN_S=20
KIOSK_DEVICE_ID=DEMO-KIOSK-01
KIOSK_API_BASE=https://api.example.invalid
KIOSK_DEVICE_TOKEN=
KIOSK_MANIFEST_KEY=
KIOSK_MANIFEST_GRACE_H=24
KIOSK_SYNC_INTERVAL_S=900
KIOSK_CACHE_DIR=/var/lib/heritage-kiosk
GPIOZERO_PIN_FACTORY=lgpio

# ── Archive API (cloud) ── README §46.2
DATABASE_URL=
OBJECT_STORE_BUCKET_MASTERS=
OBJECT_STORE_BUCKET_DERIVATIVES=
SIGNED_URL_TTL_S=300
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
ASK_DAILY_CAP=
ASK_PER_DEVICE_PER_MIN=
ASK_MIN_COVERAGE=0.5
MANIFEST_SIGNING_KEY=
MANIFEST_TTL_H=168
ADMIN_IDP_ISSUER=
ADMIN_IDP_AUDIENCE=
LOG_LEVEL=INFO
